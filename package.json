{
  "name": "cortex-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "postinstall": "node -e \"try{require('fs').cpSync(require('path').join('node_modules','@xenova','transformers','dist'),'public/wasm',{recursive:true})}catch(e){console.error('copy wasm failed:',e.message)}\"",
    "build": "node -e \"require('fs').cpSync(require('path').join('node_modules','@xenova','transformers','dist'),'public/wasm',{recursive:true})\" && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
