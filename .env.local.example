NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL for auth redirects (used in email confirmation links)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Required for real AI embeddings and AI-powered summaries
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Demo login credentials (optional — defaults to test@cortex.app if not set)
DEMO_LOGIN_EMAIL=test@cortex.app
DEMO_LOGIN_PASSWORD=your-demo-password
